{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "storage.rules",
      "FIREBASE-SETUP.md",
      "serve.ps1",
      "zizA.backup.html",
      "_*.html",
      "*.png"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/zizA.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
